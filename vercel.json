{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/stack-contact",
      "destination": "/stack-contact.html"
    },
    {
      "source": "/project-ai-study-assistant",
      "destination": "/project-ai-study-assistant.html"
    },
    {
      "source": "/project-central-kitchen",
      "destination": "/project-central-kitchen.html"
    }
  ]
}
